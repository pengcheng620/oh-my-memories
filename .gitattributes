* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Treat fixtures as data (no diff noise / no eol munging — some test
# the CRLF code path on Windows runners and must keep their bytes intact)
tests/fixtures/** -text -diff
**/tests/fixtures/** -text -diff

# Lockfile is binary
bun.lockb binary
