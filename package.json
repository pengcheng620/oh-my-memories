{
  "name": "oh-my-memories",
  "version": "0.0.0",
  "private": true,
  "description": "Manage, federate, and migrate AI memories across all your tools (Claude Code, Cursor, Codex, Gemini, Copilot, Serena, mem0, ...)",
  "license": "MIT",
  "author": "lup",
  "repository": {
    "type": "git",
    "url": "https://github.com/pengcheng620/oh-my-memories.git"
  },
  "homepage": "https://github.com/pengcheng620/oh-my-memories#readme",
  "bugs": {
    "url": "https://github.com/pengcheng620/oh-my-memories/issues"
  },
  "keywords": [
    "ai",
    "memory",
    "claude-code",
    "cursor",
    "codex",
    "gemini",
    "copilot",
    "mcp",
    "agent",
    "skill",
    "federation",
    "migration"
  ],
  "workspaces": ["packages/*", "packages/adapters/*"],
  "scripts": {
    "build": "bun run --filter '*' build",
    "test": "bun test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf packages/**/dist packages/**/node_modules node_modules"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  },
  "engines": {
    "bun": ">=1.1.0",
    "node": ">=20.0.0"
  },
  "packageManager": "bun@1.1.0"
}
